{
  "name": "memechat-second-db",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "MemeChat storage layer: Bale designated as primary (probe fails, Supabase kept temporarily active), token-free Rubika manual courier legacy, official Bale Bot API carrier, client-side direct API. No Vercel, no frontend secrets, no deletion.",
  "scripts": {
    "test": "node tests/run.mjs",
    "test:client": "node tests/run.mjs",
    "test:rubika": "node rubika/tests/run.mjs",
    "test:bale": "node bale/tests/run.mjs",
    "test:primary": "node primary/tests/run.mjs",
    "primary:trial": "node primary/cli.mjs trial --fixture --duration-ms 3000",
    "primary:preflight": "node primary/cli.mjs preflight",
    "primary:bridge-plan": "node primary/bridge-cli.mjs plan",
    "primary:bridge-verify": "node primary/bridge-cli.mjs verify",
    "primary:real-test": "bash primary/real-test.sh",
    "primary:status": "node primary/cli.mjs status",
    "test:all": "node tests/run.mjs && node rubika/tests/run.mjs && node bale/tests/run.mjs && node primary/tests/run.mjs",
    "rubika:export": "node rubika/cli.mjs export",
    "rubika:export:fixture": "node rubika/cli.mjs export --fixture",
    "rubika:export:bale:fixture": "node rubika/cli.mjs export --destination bale --fixture",
    "rubika:verify": "node rubika/cli.mjs verify",
    "rubika:status": "node rubika/cli.mjs status",
    "bale:status": "node bale/cli.mjs status --fixture",
    "bale:chat-id": "node bale/cli.mjs chat-id --fixture",
    "bale:send:fixture": "node bale/cli.mjs send --text \"سلام\" --fixture",
    "bale:help": "node bale/cli.mjs help"
  },
  "engines": { "node": ">=20" }
}
