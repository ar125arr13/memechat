{
  "name": "memechat-second-db-rubika",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "MemeChat second database: Internet Archive IAS3 carrier with ChaCha20-Poly1305 (key in source), plus token-free Rubika manual courier and Rubika Saved Messages via MAXRubika. No Vercel, no deploy, no deletion.",
  "scripts": {
    "test": "node tests/run.mjs",
    "test:rubika": "node rubika/tests/run.mjs",
    "test:maxrubika": "node maxrubika/tests/run.mjs",
    "test:maxrubika:py": "python3 -m unittest discover -s maxrubika/tests -p \"test_*.py\" -v",
    "test:internet-archive": "node internet-archive/tests/run.mjs",
    "test:all": "node tests/run.mjs && node rubika/tests/run.mjs && node maxrubika/tests/run.mjs && node internet-archive/tests/run.mjs",
    "internet-archive:status": "node internet-archive/cli.mjs status",
    "internet-archive:trial": "node internet-archive/cli.mjs trial --fixture",
    "maxrubika:status": "node maxrubika/cli.mjs status",
    "maxrubika:trial": "node maxrubika/cli.mjs trial --fixture",
    "rubika:export": "node rubika/cli.mjs export",
    "rubika:export:fixture": "node rubika/cli.mjs export --fixture",
    "rubika:verify": "node rubika/cli.mjs verify",
    "rubika:status": "node rubika/cli.mjs status"
  },
  "engines": { "node": ">=20" }
}
